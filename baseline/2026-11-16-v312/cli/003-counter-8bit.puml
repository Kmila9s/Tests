@startuml
title Kmila — Control flow
skinparam shadowing false
skinparam activity {
  BackgroundColor #f1f5f9
  BorderColor #64748b
  DiamondBackgroundColor #fae8ff
  DiamondBorderColor #a855f7
}

start
partition "entity counter / architecture rtl" {
  fork
    partition "process #1 (sensitive to: clk, n_rst)" {
      if ("n_rst = '0'") then (yes)
        :cnt <= ( others => '0' );
      elseif ("rising_edge ( clk )") then (yes)
        :cnt <= cnt + 1;
      else (no)
      endif
    }
  fork again
    :cout <= std_logic_vector ( cnt );
  end fork
}
stop
@enduml
